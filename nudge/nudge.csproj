<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Nudge</RootNamespace>
    <AssemblyName>nudge</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\nudge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- One glyph, two stroke sets: the plain files are drawn for a dark taskbar (and are also
         what the reminder card uses, since the card has its own dark surface), the -light files
         are drawn for a light taskbar. Tray.cs picks by SystemTheme.TaskbarIsLight(). -->
    <Resource Include="Assets\nudge-waiting.ico" />
    <Resource Include="Assets\nudge-done.ico" />
    <Resource Include="Assets\nudge-silent.ico" />
    <Resource Include="Assets\nudge-waiting-light.ico" />
    <Resource Include="Assets\nudge-done-light.ico" />
    <Resource Include="Assets\nudge-silent-light.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
